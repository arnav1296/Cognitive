   ],
   "source": [
    "def performance_category(rating):\n",
    "    if rating >= 4.5:\n",
    "        return \"Excellent\"\n",
    "    elif rating >= 4.0:\n",
    "        return \"Good\"\n",
    "    else:\n",
    "        return \"Average\"\n",
    "\n",
    "employees[\"Performance_Category\"] = employees[\"Rating\"].apply(performance_category)\n",
    "\n",
    "print(employees[[\"Name\", \"Rating\", \"Performance_Category\"]])\n"
   ]
  },
